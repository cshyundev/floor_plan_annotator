/* Floor Plan Annotator — Dark Theme
 * Foxglove/Omniverse inspired: deep charcoal + blue-cyan accent.
 *
 * Surface hierarchy:
 *   bg-darkest  #12141A  — canvas, viewport
 *   bg-dark     #1A1D26  — main window
 *   bg-panel    #22262F  — panels, docks, sidebars
 *   bg-header   #2A2E38  — dock titles, tab bars, toolbars
 *   bg-hover    #323844  — hover state
 *   bg-active   #3A4050  — active/selected state
 *
 * Accent: #4FC3F7 (blue-cyan)
 */

/* ── Global ── */

QMainWindow,
QWidget {
    background-color: #1A1D26;
    color: #E0E4EC;
    font-family: "Inter", "Segoe UI", "Noto Sans", sans-serif;
    font-size: 12px;
}

/* ── Menu Bar ── */

QMenuBar {
    background-color: #1A1D26;
    color: #E0E4EC;
    border-bottom: 1px solid #2E3340;
    padding: 2px 0px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
    border-radius: 3px;
}

QMenuBar::item:selected {
    background-color: #323844;
}

QMenu {
    background-color: #22262F;
    color: #E0E4EC;
    border: 1px solid #2E3340;
    padding: 4px 0px;
}

QMenu::item {
    padding: 6px 28px 6px 12px;
}

QMenu::item:selected {
    background-color: #323844;
}

QMenu::separator {
    height: 1px;
    background-color: #2E3340;
    margin: 4px 8px;
}

QMenu::item:disabled {
    color: #505868;
}

/* ── Toolbar ── */

QToolBar {
    background-color: #2A2E38;
    border-bottom: 1px solid #2E3340;
    spacing: 2px;
    padding: 3px 6px;
}

QToolBar::separator {
    width: 1px;
    background-color: #2E3340;
    margin: 4px 4px;
}

QToolBar QToolButton {
    color: #E0E4EC;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 12px;
}

QToolBar QToolButton:hover {
    background-color: #323844;
    border-color: #3A4050;
}

QToolBar QToolButton:checked {
    background-color: #2A6A8A;
    color: #4FC3F7;
    border-color: #4FC3F7;
}

QToolBar QToolButton:pressed {
    background-color: #3A4050;
}

/* ── Dock Widget ── */

QDockWidget {
    color: #E0E4EC;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background-color: #2A2E38;
    color: #E0E4EC;
    padding: 6px 8px;
    border-bottom: 1px solid #2E3340;
    font-weight: bold;
    font-size: 11px;
    text-transform: uppercase;
}

/* ── Tab Widget ── */

QTabWidget::pane {
    background-color: #22262F;
    border: 1px solid #2E3340;
    border-top: none;
}

QTabBar {
    background-color: #2A2E38;
}

QTabBar::tab {
    background-color: #2A2E38;
    color: #8890A0;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 6px 14px;
    font-size: 11px;
    min-width: 60px;
}

QTabBar::tab:hover {
    color: #E0E4EC;
    background-color: #323844;
}

QTabBar::tab:selected {
    color: #4FC3F7;
    border-bottom: 2px solid #4FC3F7;
    background-color: #22262F;
}

/* ── Buttons ── */

QPushButton {
    background-color: #22262F;
    color: #E0E4EC;
    border: 1px solid #2E3340;
    border-radius: 4px;
    padding: 5px 14px;
    font-size: 12px;
}

QPushButton:hover {
    background-color: #323844;
    border-color: #3A4050;
}

QPushButton:pressed {
    background-color: #3A4050;
}

QPushButton:disabled {
    color: #505868;
    background-color: #1A1D26;
    border-color: #22262F;
}

/* ── Labels ── */

QLabel {
    color: #E0E4EC;
    background-color: transparent;
}

/* ── CheckBox ── */

QCheckBox {
    color: #E0E4EC;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #3A4050;
    border-radius: 3px;
    background-color: #22262F;
}

QCheckBox::indicator:hover {
    border-color: #4FC3F7;
}

QCheckBox::indicator:checked {
    background-color: #4FC3F7;
    border-color: #4FC3F7;
}

/* ── ComboBox ── */

QComboBox {
    background-color: #22262F;
    color: #E0E4EC;
    border: 1px solid #2E3340;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 20px;
}

QComboBox:hover {
    border-color: #3A4050;
}

QComboBox:focus {
    border-color: #4FC3F7;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #22262F;
    color: #E0E4EC;
    border: 1px solid #2E3340;
    selection-background-color: #323844;
}

/* ── Slider ── */

QSlider::groove:horizontal {
    background-color: #2E3340;
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: #4FC3F7;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background-color: #6DD0FA;
}

QSlider::sub-page:horizontal {
    background-color: #2A6A8A;
    border-radius: 2px;
}

/* ── Splitter ── */

QSplitter::handle {
    background-color: #2E3340;
    width: 2px;
}

QSplitter::handle:hover {
    background-color: #4FC3F7;
}

/* ── Scroll Bars ── */

QScrollBar:vertical {
    background-color: #12141A;
    width: 10px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #323844;
    min-height: 30px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #3A4050;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #12141A;
    height: 10px;
    margin: 0;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #323844;
    min-width: 30px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #3A4050;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── Line Edit / Spin Box ── */

QLineEdit,
QSpinBox,
QDoubleSpinBox {
    background-color: #12141A;
    color: #E0E4EC;
    border: 1px solid #2E3340;
    border-radius: 4px;
    padding: 4px 6px;
}

QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #4FC3F7;
}

/* ── Group Box ── */

QGroupBox {
    color: #8890A0;
    border: 1px solid #2E3340;
    border-radius: 4px;
    margin-top: 8px;
    padding-top: 14px;
    font-size: 11px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    color: #8890A0;
}

/* ── Status Bar ── */

QStatusBar {
    background-color: #1A1D26;
    color: #8890A0;
    border-top: 1px solid #2E3340;
    font-size: 11px;
}

/* ── Tooltip ── */

QToolTip {
    background-color: #2A2E38;
    color: #E0E4EC;
    border: 1px solid #3A4050;
    padding: 4px 8px;
    border-radius: 3px;
    font-size: 11px;
}

/* ── Color Dialog (for type editors) ── */

QColorDialog {
    background-color: #1A1D26;
}

/* ── Tree / List Views (for future use) ── */

QTreeView,
QListView {
    background-color: #1A1D26;
    color: #E0E4EC;
    border: 1px solid #2E3340;
    alternate-background-color: #1E2230;
}

QTreeView::item:hover,
QListView::item:hover {
    background-color: #323844;
}

QTreeView::item:selected,
QListView::item:selected {
    background-color: #2A6A8A;
    color: #4FC3F7;
}

QHeaderView::section {
    background-color: #2A2E38;
    color: #8890A0;
    border: none;
    border-right: 1px solid #2E3340;
    border-bottom: 1px solid #2E3340;
    padding: 4px 8px;
    font-size: 11px;
}
