{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "floor-plan-annotator/annotations.v4.schema.json",
    "title": "Floor Plan Annotation File",
    "description": "Schema for the Floor Plan Annotator project file (annotations.json). Contains 2D floor plan annotations — walls, rooms, objects, and custom polygons — with 3D height metadata. All spatial coordinates are in meters within the coordinate system described by the coordinate_system block.",
    "type": "object",

    "$defs": {
        "Point3D": {
            "type": "array",
            "description": "A 3D point [x, y, z] in the original coordinate system (meters).",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3
        },

        "Source": {
            "type": "object",
            "description": "Metadata about the source data that was annotated.",
            "properties": {
                "file_name": {
                    "type": "string",
                    "description": "Source data file name (e.g., 'scan.ply', 'map.pgm')."
                },
                "bounds_min": {
                    "$ref": "#/$defs/Point3D",
                    "description": "Minimum corner of the source data bounding box."
                },
                "bounds_max": {
                    "$ref": "#/$defs/Point3D",
                    "description": "Maximum corner of the source data bounding box."
                },
                "occupancy_grid": {
                    "type": "object",
                    "description": "ROS2 map_server parameters. Only for data_type='occupancy_grid'. Kept for cross-reference with the map YAML.",
                    "properties": {
                        "resolution": { "type": "number", "description": "Meters per pixel." },
                        "origin": {
                            "type": "array",
                            "description": "[x, y, yaw] of the map origin.",
                            "items": { "type": "number" },
                            "minItems": 3,
                            "maxItems": 3
                        },
                        "negate": { "type": "integer", "enum": [0, 1] },
                        "occupied_thresh": { "type": "number" },
                        "free_thresh": { "type": "number" }
                    },
                    "additionalProperties": false
                }
            },
            "required": ["file_name"],
            "additionalProperties": false
        },

        "Wall": {
            "type": "array",
            "description": "A wall segment as two 3D endpoints: [start, end].",
            "items": { "$ref": "#/$defs/Point3D" },
            "minItems": 2,
            "maxItems": 2
        },

        "Room": {
            "type": "object",
            "description": "A room defined by a closed polygon of 3D vertices. Last vertex connects back to the first.",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Unique identifier for this room."
                },
                "type": {
                    "type": "string",
                    "description": "Semantic room type (e.g., 'bedroom', 'kitchen', 'bathroom')."
                },
                "points": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/Point3D" },
                    "minItems": 3,
                    "description": "Ordered polygon vertices. Implicitly closed."
                }
            },
            "required": ["id", "type", "points"],
            "additionalProperties": false
        },

        "Object": {
            "type": "object",
            "description": "An oriented bounding box (OBB) in 3D space.",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Unique identifier for this object."
                },
                "type": {
                    "type": "string",
                    "description": "Semantic object type (e.g., 'furniture', 'appliance', 'obstacle')."
                },
                "center": {
                    "$ref": "#/$defs/Point3D",
                    "description": "Center of the OBB."
                },
                "extent": {
                    "type": "array",
                    "description": "Full size [width, height, depth] along local axes before rotation (meters).",
                    "items": { "type": "number" },
                    "minItems": 3,
                    "maxItems": 3
                },
                "rotation": {
                    "type": "array",
                    "description": "Orientation as quaternion [w, x, y, z].",
                    "items": { "type": "number" },
                    "minItems": 4,
                    "maxItems": 4
                }
            },
            "required": ["id", "type", "center", "extent", "rotation"],
            "additionalProperties": false
        },

        "Zone": {
            "type": "object",
            "description": "A purpose-defined area on the floor (e.g., no-go zone, caution zone). Closed polygon of 3D vertices.",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Unique identifier for this zone."
                },
                "type": {
                    "type": "string",
                    "description": "Zone purpose (e.g., 'no_go', 'caution', 'clean', 'restricted')."
                },
                "points": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/Point3D" },
                    "minItems": 3,
                    "description": "Ordered polygon vertices. Implicitly closed."
                }
            },
            "required": ["id", "type", "points"],
            "additionalProperties": false
        }
    },

    "properties": {
        "version": {
            "type": "string",
            "const": "1.0",
            "description": "Schema version. Must be '1.0' for this schema."
        },
        "data_type": {
            "type": "string",
            "enum": ["point_cloud", "mesh", "occupancy_grid"],
            "description": "Type of the source 3D data that was annotated. 'point_cloud' = PLY/PCD/OBJ/STL, 'mesh' = GLB/GLTF, 'occupancy_grid' = ROS2 map_server format (PGM/PNG + YAML)."
        },
        "coordinate_system": {
            "type": "string",
            "enum": ["ros", "opencv", "opengl"],
            "description": "Coordinate system convention of the source 3D data."
        },
        "floor_level": {
            "type": "number",
            "description": "Height of the floor surface along the up-axis in the original 3D coordinate system (meters). Reference only — all z_min/z_max values are absolute in the same coordinate system.",
            "default": 0.0
        },
        "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of the first save. Set once and never overwritten on subsequent saves."
        },
        "modified_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of the most recent save. Updated on every save."
        },
        "source": {
            "$ref": "#/$defs/Source"
        },
        "layout": {
            "type": "object",
            "description": "Structural layout: walls and rooms.",
            "properties": {
                "walls": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/Wall" },
                    "description": "Wall segments. Each wall is [start, end].",
                    "default": []
                },
                "rooms": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/Room" },
                    "description": "Room annotations.",
                    "default": []
                }
            },
            "additionalProperties": false
        },
        "objects": {
            "type": "array",
            "items": { "$ref": "#/$defs/Object" },
            "description": "Object annotations.",
            "default": []
        },
        "zones": {
            "type": "array",
            "items": { "$ref": "#/$defs/Zone" },
            "description": "Purpose-defined floor areas (no-go, caution, etc.).",
            "default": []
        }
    },

    "required": ["version", "data_type", "coordinate_system", "layout"],
    "additionalProperties": false
}
