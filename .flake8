[flake8]
max-line-length = 150
ignore =
    E203,  # Whitespace before ':' (conflicts with Black formatter)
    W503   # Line break before binary operator (modern style prefers this)

exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    *.egg-info

per-file-ignores =
    __init__.py:F401  # Allow unused imports in __init__.py files
